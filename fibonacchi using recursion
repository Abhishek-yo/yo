#include<stdio.h>
int fibonacchi(int c){
    
    if( c == 0){
        return 0;

    }
    else if(c == 1){
        return 1;
    }
    else{
        return (fibonacchi(c-2) + fibonacchi(c-1));
    }
    
}
int main(){
    int n;
    scanf("%d",&n);
    for( int i =0 ; i< n; i++){
        printf("%d",fibonacchi(i));
    }
    return 0;

}
