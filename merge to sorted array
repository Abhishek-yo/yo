#include<stdio.h>
int main()
{
    int i=0,j=0,k=0;
    int ar1[] = {1,3,5,6,9};
    int ar2[] = {0,2,5,7,8};
    int ar3[10];
    while( i < 5 && j <5){
        if(ar1[i] > ar2[j]){
            ar3[k] =ar2[j];
            k++;
            j++;
        }
        else{
            ar3[k] =ar1[i];
            k++;
            i++; 
        }
        

    }
    while(i<5){
        ar3[k++] = ar1[i++];
    }
    while(j< 5){
        ar3[k++] = ar2[j++];
    }
    for(int x = 0;x<10;x++)
        printf("%d",ar3[x]);

    return 0;
}
