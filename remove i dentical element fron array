#include <stdio.h>
int main() {
    int ar[] = {1, 1, 1, 2, 2, 2, 3, 3, 4, 5, 6, 7, 8, 8, 8, 9, 9};
    int n = 17; 
    int a[100];
    int j = 0;
    a[j++] = ar[0];
    for (int i = 1; i < n; i++) {
        if (ar[i] != a[j - 1]) {
            a[j] = ar[i];
            j++;
        }
    }
    printf("Unique elements: ");
    for (int k = 0; k < j; k++) {
        printf("%d ", a[k]);
    }
    printf("\nNumber of unique elements (j): %d\n", j);
    return 0;
}
