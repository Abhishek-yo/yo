#include<stdio.h>
int main(){
    int n,temp;
    printf("enterthe lenghth of array");
    scanf("%d",&n);
    int ar[n];
    for(int i = 0; i< n; i ++){
        scanf("%d",&ar[i]);

    }
    for(int i = 0; i< n/2; i ++){
        temp = ar[i];
        ar[i]=ar[n-1-i];
        ar[n-1-i]=temp;
    }
    for(int i = 0; i< n; i ++){
        printf("%d",ar[i]);
    }
    return 0;
}
