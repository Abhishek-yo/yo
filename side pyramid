#include<iostream>
using namespace std;
void pattern(int num);
int main(){
    cout<<"enter the number of iteration\n";
    int num;
    cin>>num;
    cout<<"the entered number is\n"<<num;
    printf("\n");
    pattern(num);
    
}
void pattern(int num){
    for(int i=0;i<=num;i++){
        
        for(int k=0;k<i;k++){
            printf("x");
        }
        printf("\n");
    }
    for(int i=num-1;i>0;i--){
        
        
        for(int k=0;k<i;k++){
            printf("x");
        }
        printf("\n");
    }
}
